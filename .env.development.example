# ==============================================================================
# MarketScope.io — Development Environment Configuration Template
# ==============================================================================
# Copy to .env or use with local Docker setup.
# ==============================================================================

APP_ENV=development
APP_NAME="MarketScope.io API (Dev)"
APP_VERSION=1.0.0
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=local_development_secret_key_minimum_32_chars_123456789
SNAPSHOT_SIGNING_SALT=marketscope_snapshot_signing_salt_development

API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local PostgreSQL or Neon Dev instance
DATABASE_URL=postgresql+psycopg://marketscope:local_dev_change_me@localhost:5432/marketscope
REDIS_URL=redis://localhost:6379/0

# Clerk Development Instance
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_from_clerk
CLERK_SECRET_KEY=sk_test_placeholder_from_clerk
CLERK_WEBHOOK_SECRET=whsec_placeholder

# Market Data
TWELVEDATA_API_KEY=your_twelvedata_api_key
FMP_API_KEY=your_fmp_api_key

# AI Providers
AI_ENABLED=true
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key

# Frontend Client Public Settings
NEXT_PUBLIC_APP_NAME="MarketScope.io (Dev)"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_HOST=localhost:8000
NEXT_PUBLIC_AI_ENABLED=true
