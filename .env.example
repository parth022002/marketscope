# ==============================================================================
# MarketScope.io — Master Environment Configuration Template
# ==============================================================================
# Comprehensive register across all 18 enterprise configuration categories.
# Copy this file to .env for local development. Never commit live secrets to git.
# Documentation: docs/deployment/MASTER_ENVIRONMENT_VARIABLE_REGISTER.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION CORE & RUNTIME METADATA
# ------------------------------------------------------------------------------
APP_ENV=development
APP_NAME="MarketScope.io API"
APP_VERSION=1.0.0
APP_DEBUG=true
PORT=8000
HOST=0.0.0.0
SECRET_KEY=replace_with_min_32_char_cryptographically_secure_random_key_here
SNAPSHOT_SIGNING_SALT=marketscope_snapshot_signing_salt_development

# ------------------------------------------------------------------------------
# 2. NETWORKING, ROUTING & CORS
# ------------------------------------------------------------------------------
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://marketscope-web.vercel.app
ALLOWED_HOSTS=localhost,127.0.0.1,marketscope-api.onrender.com

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL 16+ / NEON SERVERLESS)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/marketscope
# Neon serverless direct / pooled connection URL (SSL mode required for cloud):
# DATABASE_URL=postgresql+psycopg://user:pass@ep-sample.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_URL=
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=15

# ------------------------------------------------------------------------------
# 4. CACHE & PUBSUB (REDIS / UPSTASH)
# ------------------------------------------------------------------------------
# Optional: system operates seamlessly with in-memory caching if Redis is offline
REDIS_URL=redis://localhost:6379/0
REDIS_TTL_QUOTES=10
REDIS_TTL_DISCOVERY=300
REDIS_TTL_RAG=3600

# ------------------------------------------------------------------------------
# 5. AUTHENTICATION & IDENTITY (CLERK)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_from_clerk_dashboard
CLERK_SECRET_KEY=sk_test_placeholder_from_clerk_dashboard
CLERK_WEBHOOK_SECRET=whsec_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workspace
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/workspace

# ------------------------------------------------------------------------------
# 6. PRIMARY FINANCIAL MARKET DATA (TWELVE DATA)
# ------------------------------------------------------------------------------
# Verified commercial tier / free tier (key required for live market streaming)
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
TWELVEDATA_BASE_URL=https://api.twelvedata.com
TWELVEDATA_RATE_LIMIT=8

# ------------------------------------------------------------------------------
# 7. SECONDARY FINANCIAL DATA (FINANCIAL MODELING PREP - FMP)
# ------------------------------------------------------------------------------
# Free / Starter tier (fallback to canonical engine on rate limits / 429)
FMP_API_KEY=your_fmp_api_key_here
FMP_BASE_URL=https://financialmodelingprep.com/api/v3

# ------------------------------------------------------------------------------
# 8. ALTERNATIVE / INSTITUTIONAL DATA PROVIDERS (LICENCE PENDING)
# ------------------------------------------------------------------------------
# Institutional commercial connectors — optional / commercial license required
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
POLYGON_API_KEY=
SEC_EDGAR_USER_AGENT="MarketScope.io admin@marketscope.io"

# ------------------------------------------------------------------------------
# 9. AI SYNTHESIS — GROQ CLOUD (LLaMA-3.3 70B VERSATILE)
# ------------------------------------------------------------------------------
# Primary ultra-low-latency financial analyst synthesis engine
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AI_ENABLED=true

# ------------------------------------------------------------------------------
# 10. AI SYNTHESIS — GOOGLE GEMINI (FLASH / PRO)
# ------------------------------------------------------------------------------
# Multimodal & deep financial reasoning tier
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# 11. AI SYNTHESIS — OPENROUTER AI GATEWAY
# ------------------------------------------------------------------------------
# Multi-model redundancy fallback gateway
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ------------------------------------------------------------------------------
# 12. WORLDWIDE NEWS & SENTIMENT INTELLIGENCE
# ------------------------------------------------------------------------------
NEWS_API_KEY=
FINANCIAL_NEWS_CACHE_MINUTES=15
NEWS_SENTIMENT_THRESHOLD=0.15

# ------------------------------------------------------------------------------
# 13. GLOBAL MACROECONOMIC & ECONOMIC CALENDAR
# ------------------------------------------------------------------------------
FRED_API_KEY=
TRADING_ECONOMICS_KEY=
CALENDAR_LOOKAHEAD_DAYS=30

# ------------------------------------------------------------------------------
# 14. MULTI-FACTOR QUANTITATIVE ENGINE (Q-INTELLIGENCE)
# ------------------------------------------------------------------------------
Q_INTEL_SAMPLE_WINDOW_DAYS=756
Q_INTEL_RISK_FREE_RATE=0.0425
Q_INTEL_CONFIDENCE_THRESHOLD=0.65
Q_INTEL_MONTE_CARLO_SIMS=1000

# ------------------------------------------------------------------------------
# 15. FRONTEND CLIENT EXPOSURE (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="MarketScope.io"
NEXT_PUBLIC_APP_TAGLINE="Financial Research & Intelligence"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_HOST=localhost:8000
NEXT_PUBLIC_AI_ENABLED=true

# ------------------------------------------------------------------------------
# 16. OBSERVABILITY, LOGGING & ERROR TRACKING
# ------------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGS=false

# ------------------------------------------------------------------------------
# 17. SECURITY, RATE LIMITING & AUDITING
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=30
ENABLE_SECURITY_HEADERS=true
ADMIN_KEY=dev_admin_key_replace_for_prod

# ------------------------------------------------------------------------------
# 18. DEPLOYMENT TARGET SPECIFIC CONFIGURATION
# ------------------------------------------------------------------------------
RENDER_SERVICE_ID=
VERCEL_ENV=development
