# ==============================================================================
# MarketScope.io — Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. Never commit .env to source control.
# Values with placeholders should be filled according to docs/USER_INPUT_AND_CONFIGURATION_GUIDE.md
# ==============================================================================

# --- Application Core ---
APP_ENV=development
APP_NAME=MarketScope.io
APP_DEBUG=true
SECRET_KEY=local_development_secret_key_minimum_32_chars_long_123456
SNAPSHOT_SIGNING_SALT=marketscope_snapshot_signing_salt_development

# --- URLs & Network ---
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL 16+ / Neon) ---
# Default points to local Docker Compose container:
POSTGRES_DB=marketscope
POSTGRES_USER=marketscope
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://marketscope:local_dev_change_me@localhost:5432/marketscope
# Neon serverless pooled connection URL (optional for cloud staging):
# DATABASE_POOL_URL=postgresql+psycopg://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/marketscope?sslmode=require

# --- Cache & Rate Limiting (Redis / Upstash) ---
REDIS_URL=redis://localhost:6379/0
# Upstash REST credentials (for serverless cloud deployment):
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=example_token

# --- Authentication & Identity (Clerk / OIDC) ---
# Set MOCK_AUTH_ENABLED=true for offline local development without external credentials
MOCK_AUTH_ENABLED=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_from_clerk_dashboard
CLERK_SECRET_KEY=sk_test_placeholder_from_clerk_dashboard
CLERK_WEBHOOK_SECRET=whsec_placeholder

# --- Financial Market Data Integrations ---
# Default: mock provider with synthetic Indian equity fixtures (Reliance, TCS, INFY)
MARKET_DATA_PROVIDER=mock
# Future commercial providers (disabled until license review in Phase 4):
# NSE_DATA_VENDOR_ID=
# NSE_DATA_API_KEY=
# BSE_DATA_API_KEY=

# --- Object Storage (Cloudflare R2 / S3 Compatible) ---
# STORAGE_PROVIDER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=marketscope-filings-dev

# --- AI & Intelligent Research (STRICTLY GATED - Phase 5) ---
AI_ENABLED=false
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-4o

# --- Telemetry & Error Tracking ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
