# ==============================================================================
# MarketScope.io — Master Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development. Never commit .env to source control.
# Full reference guide: docs/operations/ENVIRONMENT_CONFIGURATION.md
# ==============================================================================

# --- Application Core ---
APP_ENV=development
APP_NAME="MarketScope.io API"
APP_DEBUG=true
SECRET_KEY=local_development_secret_key_minimum_32_chars_long_123456
SNAPSHOT_SIGNING_SALT=marketscope_snapshot_signing_salt_development
PORT=8000

# --- URLs & Network ---
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
API_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL 16+ / Neon Serverless) ---
# Local Docker or development PostgreSQL:
POSTGRES_DB=marketscope
POSTGRES_USER=marketscope
POSTGRES_PASSWORD=local_dev_change_me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://marketscope:local_dev_change_me@localhost:5432/marketscope
# Neon serverless pooled connection URL (for production / cloud deployment):
# DATABASE_URL=postgresql+psycopg://user:password@ep-sample-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_POOL_URL=

# --- Cache & PubSub (Redis) ---
REDIS_URL=redis://localhost:6379/0

# --- Authentication & Identity (Clerk) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_from_clerk_dashboard
CLERK_SECRET_KEY=sk_test_placeholder_from_clerk_dashboard
CLERK_WEBHOOK_SECRET=whsec_placeholder

# --- Financial Market Data Integrations ---
# Provider mode: hybrid | twelvedata | fmp | offline
MARKET_DATA_PROVIDER=hybrid
TWELVEDATA_API_KEY=your_twelvedata_api_key_here
FMP_API_KEY=your_fmp_api_key_here
FINANCIAL_DATA_API_KEY=

# --- AI & News Intelligence ---
AI_ENABLED=true
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Telemetry & Error Tracking ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# --- Frontend Web Application (apps/web/.env.local) ---
NEXT_PUBLIC_APP_NAME="MarketScope.io"
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
