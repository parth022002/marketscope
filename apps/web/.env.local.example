# MarketScope.io — Web Application (Next.js) Environment Template
# Copy to apps/web/.env.local for local frontend development.

NEXT_PUBLIC_APP_NAME="MarketScope.io"
NEXT_PUBLIC_APP_TAGLINE="Financial Research & Intelligence"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000"
NEXT_PUBLIC_WS_HOST="localhost:8000"

# Authentication (Clerk) - Leave blank if backend MOCK_AUTH_ENABLED=true
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_placeholder"
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/workspace"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/workspace"

# Sentry Error Reporting (Phase 6)
# NEXT_PUBLIC_SENTRY_DSN=""
