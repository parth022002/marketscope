# ==============================================================================
# MarketScope.io — Frontend Production Environment (Vercel Production)
# ==============================================================================
# Set these variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

NEXT_PUBLIC_APP_NAME="MarketScope.io"
NEXT_PUBLIC_APP_TAGLINE="Financial Research & Intelligence"
NEXT_PUBLIC_API_BASE_URL="https://marketscope-api.onrender.com"
NEXT_PUBLIC_WS_HOST="marketscope-api.onrender.com"

# Clerk Production Mode Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_live_your_clerk_production_publishable_key"
CLERK_SECRET_KEY="sk_live_your_clerk_production_secret_key"

NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/workspace"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/workspace"

NEXT_PUBLIC_AI_ENABLED="true"
NEXT_PUBLIC_SENTRY_DSN=""
