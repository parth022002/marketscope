# MarketScope.io — Backend API (FastAPI) Environment Template
# Copy to apps/api/.env for local backend development.

APP_NAME="MarketScope.io API"
APP_ENV="development"
APP_DEBUG="true"
SECRET_KEY="local_development_secret_key_minimum_32_chars_long_123456"
SNAPSHOT_SIGNING_SALT="marketscope_snapshot_signing_salt_development"

API_CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

DATABASE_URL="postgresql+psycopg://marketscope:local_dev_change_me@localhost:5432/marketscope"
REDIS_URL="redis://localhost:6379/0"

# Set to true to inject synthetic local user session without external Clerk keys
MOCK_AUTH_ENABLED="true"

# Clerk credentials for multi-user staging
CLERK_SECRET_KEY=""
CLERK_ISSUER_URL=""

# Provider configuration (options: hybrid, twelvedata, fmp, synthetic)
MARKET_DATA_PROVIDER="hybrid"
FMP_API_KEY=""
TWELVEDATA_API_KEY=""
FINANCIAL_DATA_API_KEY=""
TRUEDATA_API_USER=""
TRUEDATA_API_PASSWORD=""

# AI Integration (Strictly gated, false in Phase 1-4)
AI_ENABLED="false"
