# ==============================================================================
# MarketScope.io — Automated Test Environment Template (CI / Pytest)
# ==============================================================================

APP_ENV=test
APP_NAME="MarketScope.io API (Test)"
APP_VERSION=1.0.0
APP_DEBUG=false
SECRET_KEY=test_cryptographic_secret_key_minimum_32_characters_12345
SNAPSHOT_SIGNING_SALT=test_snapshot_salt

API_BASE_URL=http://testserver
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://testserver,http://localhost:3000

# SQLite or Isolated Test Postgres
DATABASE_URL=sqlite+aiosqlite:///:memory:
REDIS_URL=

# Clerk Mock
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_mock_for_pytest
CLERK_SECRET_KEY=sk_test_mock_for_pytest
CLERK_WEBHOOK_SECRET=whsec_mock

# Providers Mocked / Offline
MARKET_DATA_PROVIDER=offline
TWELVEDATA_API_KEY=test_twelvedata_mock_key
FMP_API_KEY=test_fmp_mock_key
AI_ENABLED=false
GROQ_API_KEY=mock_groq_key
GEMINI_API_KEY=mock_gemini_key
OPENROUTER_API_KEY=mock_openrouter_key

LOG_LEVEL=WARNING
