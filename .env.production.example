# ==============================================================================
# MarketScope.io — Production Environment Configuration Template
# ==============================================================================
# Target: Render Web Service (Backend) & Vercel (Frontend)
# Never commit real secrets. Store these in Render / Vercel Environment Settings.
# ==============================================================================

APP_ENV=production
APP_NAME="MarketScope.io API"
APP_VERSION=1.0.0
APP_DEBUG=false
PORT=10000
HOST=0.0.0.0
# Generate 64-character hex key via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=generate_and_set_strong_production_secret_key_64_chars_min
SNAPSHOT_SIGNING_SALT=generate_strong_production_signing_salt

# Cross-Service Networking
API_BASE_URL=https://marketscope-api.onrender.com
WEB_BASE_URL=https://marketscope-web.vercel.app
CORS_ORIGINS=https://marketscope-web.vercel.app,https://marketscope.io,https://www.marketscope.io
ALLOWED_HOSTS=marketscope-api.onrender.com,*.onrender.com

# Neon Serverless PostgreSQL (Direct SSL Required)
DATABASE_URL=postgresql+psycopg://username:password@ep-your-instance.c-5.ap-southeast-1.aws.neon.tech/marketscope_db?sslmode=require
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10
DB_TIMEOUT_SECONDS=15

# Upstash Redis / Redis Cloud (Optional: gracefully falls back to in-memory caching)
REDIS_URL=rediss://default:token@your-upstash-redis-instance.upstash.io:6379

# Clerk Authentication (Production Instance)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_your_clerk_live_key
CLERK_SECRET_KEY=sk_live_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/workspace
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/workspace

# Market Data Providers
TWELVEDATA_API_KEY=your_verified_twelvedata_commercial_key
FMP_API_KEY=your_verified_fmp_commercial_key

# Multi-Model AI Synthesis Cascade
AI_ENABLED=true
GROQ_API_KEY=gsk_your_groq_production_key
GEMINI_API_KEY=your_gemini_production_key
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key

# Telemetry & Observability
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project
LOG_LEVEL=INFO
ENABLE_STRUCTURED_JSON_LOGS=true

# Security & Rate Limiting
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_AI_PER_MINUTE=30
ENABLE_SECURITY_HEADERS=true
ADMIN_KEY=generate_strong_random_admin_bearer_token
